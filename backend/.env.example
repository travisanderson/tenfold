# Copy to .env and fill in. The server reads .env at startup; .env is gitignored.

# --- Required ---------------------------------------------------------------

# Postgres on Supabase. Use the SESSION POOLER string (port 5432), not the
# transaction pooler (6543). Dashboard: Connect > Session pooler.
# URL-encode the password if it has special characters (@ becomes %40).
DATABASE_URL=

# The project URL. Tokens are verified against its public signing keys at
# /auth/v1/.well-known/jwks.json, so no JWT secret is needed.
SUPABASE_URL=

# A secret key, used only on the server to sign upload URLs and read files.
# Dashboard: Settings > API Keys > Secret keys (sb_secret_...), or the legacy
# service_role key. Never the publishable or anon key.
SUPABASE_SERVICE_KEY=

# --- Optional (defaults shown) ----------------------------------------------

# Only when the server and the browser reach Supabase at different addresses,
# as in Docker: the URL the browser uses. Signed upload URLs are built on it.
# SUPABASE_PUBLIC_URL=            # defaults to SUPABASE_URL

# Only when the project signs tokens with a shared secret and not with keys
# published at the JWKS URL. Local Supabase does.
# SUPABASE_JWT_SECRET=

# PORT=8080
# STORAGE_BUCKET=logs
# SAMPLES_BUCKET=samples
# SAMPLES_DIR=            # set to read the demo logs from a folder instead
# DB_MAX_CONNS=8
# RISK_THRESHOLD=30

# --- AI ---------------------------------------------------------------------

# Three roles, one provider each. A provider is jev, claude, mock or none.
#
#   Judge         Labels each anomaly: likely malicious, likely benign or
#                 inconclusive. Its label can set a low-scoring group aside.
#   Shadow judge  Labels the same anomalies, for the scorecard to compare.
#                 Its labels are saved and change nothing. Optional.
#   Narrator      Writes each incident's report. Jev cannot; it does not
#                 write text.
#
# mock is an offline stand-in that labels by risk score: no key, no cost.
# With the judge set to none, scores, evidence and incidents are complete
# and the upload ends as "partial".
#
# The full setup is jev, claude, claude.
# AI_JUDGE_PROVIDER=mock
# AI_SHADOW_JUDGE_PROVIDER=none
# AI_NARRATIVE_PROVIDER=mock

# Needed when a role above is claude. An API key from console.anthropic.com
# (API keys). A Claude.ai subscription does not include one.
# ANTHROPIC_API_KEY=

# Needed when a role above is jev. An API key from console.typesafe.ai/keys.
# JEV_API_KEY=

# JEV_MODEL=jev-1.13.0                      # pinned; the threshold was set against it
# CLAUDE_JUDGE_MODEL=claude-haiku-5-5       # one request per anomaly
# CLAUDE_NARRATIVE_MODEL=claude-opus-5-5    # one request per incident

# Copy to .env and fill in. The server reads .env at startup; .env is gitignored.

# --- Required ---------------------------------------------------------------

# Postgres on Supabase. Use the SESSION POOLER string (port 5432), not the
# transaction pooler (6543). Dashboard: Connect > Session pooler.
# URL-encode the password if it has special characters (@ becomes %40).
DATABASE_URL=

# The project URL. Tokens are verified against its public signing keys at
# /auth/v1/.well-known/jwks.json, so no JWT secret is needed.
SUPABASE_URL=

# A secret key, used only on the server to sign upload URLs and read files.
# Dashboard: Settings > API Keys > Secret keys (sb_secret_...), or the legacy
# service_role key. Never the publishable or anon key.
SUPABASE_SERVICE_KEY=

# --- Optional (defaults shown) ----------------------------------------------

# PORT=8080
# STORAGE_BUCKET=logs
# SAMPLES_BUCKET=samples
# SAMPLES_DIR=            # set to read the demo logs from a folder instead
# DB_MAX_CONNS=8
# RISK_THRESHOLD=30

# --- AI ---------------------------------------------------------------------

# Who judges each anomaly, and who writes each incident's report:
#
#   jev     Jev judges. Claude writes, and judges in shadow. Needs both keys.
#   claude  Claude judges and writes. The mock judges in shadow.
#   mock    An offline stand-in that labels by risk score. No key, no cost.
#   none    No AI. Risk scores, evidence and incidents are still complete.
#
# A shadow judge's rulings are saved for the scorecard. They change nothing.
# AI_PROVIDER=mock

# An API key from console.anthropic.com (API keys). A Claude.ai
# subscription does not include one.
# ANTHROPIC_API_KEY=

# An API key from console.typesafe.ai/keys.
# JEV_API_KEY=

# JEV_MODEL=jev-1.13.0                  # pinned; thresholds were set against it
# AI_JUDGE_MODEL=claude-haiku-5-5       # Claude's judge: one request per anomaly
# AI_NARRATIVE_MODEL=claude-opus-5-5    # one request per incident

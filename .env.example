# Settings for running Tenfold on one machine:
#
#   npx supabase start
#   docker compose up
#
# Compose reads this file as it is. There is nothing to copy or fill in.
#
# Every value here is a public default of the Supabase CLI's local stack.
# They are the same on every machine, they protect nothing, and they work
# only against the Supabase on your own computer. Production's settings
# live in Railway and Vercel, never in a file.
#
# To change a setting, put its line in a file named .env beside this one.
# That file wins, and git ignores it.

# --- Supabase, as the containers reach it ------------------------------------

# Supabase runs on your machine, outside these containers.
SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres?sslmode=disable

# --- Supabase, as your browser reaches it ------------------------------------

# Your browser sends an uploaded file straight to storage, so the signed
# upload link must use an address the browser can open.
SUPABASE_PUBLIC_URL=http://localhost:54321

# --- Local keys ---------------------------------------------------------------

# NOT FILLED IN YET. These three take the values `npx supabase status`
# prints for the local stack. They are being added once that has run here.
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=

# --- AI -----------------------------------------------------------------------

# mock is an offline stand-in: it labels by risk score and writes each
# report from a template, with real citations. It needs no key and costs
# nothing. For the real models, set a role to claude and add the key.
AI_JUDGE_PROVIDER=mock
AI_SHADOW_JUDGE_PROVIDER=none
AI_NARRATIVE_PROVIDER=mock

# Optional. Only needed when a role above is claude.
ANTHROPIC_API_KEY=
